{
  "name": "agent-utility",
  "version": "0.1.0",
  "description": "Testnet-only x402 UK company information experiment",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "buyer": "node --import tsx scripts/buyer.ts",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "metrics": "wrangler d1 execute agent-utility-metrics --remote --file scripts/metrics.sql",
    "probe:live": "node --import tsx scripts/live-probe.ts",
    "mcp": "node --import tsx scripts/mcp.ts",
    "wallet:init": "node --import tsx scripts/init-wallets.ts",
    "configure": "node --import tsx scripts/configure.ts",
    "test:runtime": "node --import tsx scripts/runtime-smoke.ts",
    "discovery:check": "node --import tsx scripts/discovery-check.ts",
    "secrets:check": "node scripts/secret-scan.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "hono": "4.13.12",
    "viem": "2.57.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@types/node": "26.6.4",
    "eslint": "10.11.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
